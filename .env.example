# File nay la ban mau. Chuong trinh tu chep thanh .env khi chay lan dau.
# Khong can sua tay: vao man hinh Cai dat trong phan mem de nhap khoa API,
# chuong trinh se tu ghi vao day.
# File .env khong bao gio duoc dua len git. Khong bao gio dan khoa vao tin nhan.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Facebook (M5). Nhap trong Cai dat -> Facebook, khong can sua tay.
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Cong chay tren may. Doi neu bi trung.
PORT=5173

# Chi khi chay tren VPS sau Caddy / Nginx co dang nhap (docs/TRIEN-KHAI-VPS.md): dia chi https cua shop.
# MOZA_DIA_CHI_NGOAI=https://shop.ten-mien-cua-ban.vn
